<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SkipLocalWindowsServiceAutomation Condition="'$(SkipLocalWindowsServiceAutomation)' == ''">false</SkipLocalWindowsServiceAutomation>
    <LocalWindowsServiceName>ThreeBooks.BookBackend.Api</LocalWindowsServiceName>
    <LocalWindowsServiceDisplayName>ThreeBooks BookBackend Api</LocalWindowsServiceDisplayName>
    <LocalWindowsServiceSourceScript>$(MSBuildProjectDirectory)\scripts\Deploy-LocalWindowsService.ps1</LocalWindowsServiceSourceScript>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Service.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Local.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Update="scripts\Deploy-LocalWindowsService.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <Content Include="..\ThreeBooks.BookBackend.Infrastructure\Sql\**\*.sql"
             Link="InfrastructureSql\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThreeBooks.BookBackend.Application\ThreeBooks.BookBackend.Application.csproj" />
    <ProjectReference Include="..\ThreeBooks.BookBackend.Infrastructure\ThreeBooks.BookBackend.Infrastructure.csproj" />
    <ProjectReference Include="..\ThreeBooks.BookBackend.Contracts\ThreeBooks.BookBackend.Contracts.csproj" />
  </ItemGroup>

  <Target Name="StopLocalWindowsServiceBeforePublish"
      BeforeTargets="_IncrementalCleanPublishDirectory;_CopyResolvedFilesToPublishPreserveNewest;_CopyResolvedFilesToPublishAlways"
      Condition="'$(EnableLocalWindowsServiceAutomation)' == 'true' and '$(SkipLocalWindowsServiceAutomation)' != 'true'">
    <Message Text="Stopping local Windows service '$(LocalWindowsServiceName)' before publish." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LocalWindowsServiceSourceScript)&quot; -Action Stop -ServiceName &quot;$(LocalWindowsServiceName)&quot;" />
  </Target>

  <Target Name="DeployLocalWindowsServiceAfterPublish"
          AfterTargets="Publish"
      Condition="'$(EnableLocalWindowsServiceAutomation)' == 'true' and '$(SkipLocalWindowsServiceAutomation)' != 'true'">
    <Message Text="Deploying local Windows service '$(LocalWindowsServiceName)' after publish." Importance="high" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(PublishDir)scripts\Deploy-LocalWindowsService.ps1&quot; -Action Deploy -ServiceName &quot;$(LocalWindowsServiceName)&quot; -DisplayName &quot;$(LocalWindowsServiceDisplayName)&quot;" />
  </Target>

</Project>
